# ── Access ────────────────────────────────────────────────────────────────
# Password-protects the whole dashboard (browser asks for user + password).
# Leave empty only for local development.
DASHBOARD_USER=strongest
DASHBOARD_PASSWORD=

# Bearer token for /api/ingest and the /api/mcp server (Claude or other tools).
INGEST_TOKEN=

# Vercel sets this automatically for cron jobs once you add it in Project Settings.
CRON_SECRET=

# ── Storage (Upstash Redis via the Vercel Marketplace) ────────────────────
# Without these the dashboard still works, but edits are kept only in your browser.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Amazon SP-API (Login with Amazon app credentials) ─────────────────────
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
# One refresh token per region (from authorizing your app in that region's Seller Central):
SPAPI_REFRESH_TOKEN_NA=   # US + Canada
SPAPI_REFRESH_TOKEN_EU=   # UK + DE/FR/IT/ES
# If a country runs on a separate Seller Central account, give it its own token; it wins over the region one:
#   SPAPI_REFRESH_TOKEN_US / _CA / _UK / _DE / _FR / _IT / _ES
# and, if that account uses a different SP-API app, its own app keys too:
#   SPAPI_CLIENT_ID_CA, SPAPI_CLIENT_SECRET_CA   (same pattern for any country or NA/EU)

# Column sources (fixed):
#   Amazon             = FBA available + FC processing (no inbound)
#   External Warehouse = AWD available units (US only)
#   Last 30 days sales = Business Reports (Units Ordered, child ASIN)

# ── Proboxx (fills OTW-1 / OTW-2) ─────────────────────────────────────────
PROBOXX_API_URL=
PROBOXX_API_KEY=
# Optional: header name if Proboxx doesn't use "Authorization: Bearer <key>" (e.g. x-api-key)
PROBOXX_AUTH_HEADER=
